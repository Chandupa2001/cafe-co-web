---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/dm-sans/wght.css';
import '../styles/global.css';
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import dmSansUrl from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import { site } from '../data/site';
import Preloader from '../components/Preloader.astro';
import InkDefs from '../components/story/InkDefs.astro';

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og-image.jpg', site.url).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  name: site.fullName,
  url: site.url,
  image: ogImage,
  logo: new URL('/favicon-192.png', site.url).href,
  slogan: site.tagline,
  foundingDate: site.foundingYear,
  telephone: site.phone.international,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: site.hours.opens,
    closes: site.hours.closes,
  },
  sameAs: [site.links.instagram, site.links.facebook],
};
---

<!doctype html>
<html lang="en-LK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.seo.title}</title>
    <meta name="description" content={site.seo.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />

    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSansUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:locale" content="en_LK" />
    <meta property="og:title" content={site.seo.title} />
    <meta property="og:description" content={site.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Cafe' Co. logo" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // The short welcome screen shows once per visit, and never with reduced motion or Data Saver
        try {
          var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var saveData = navigator.connection && navigator.connection.saveData;
          // The scroll-driven "Bean to cup" story; reduced motion gets still drawings instead
          if (!calm) root.classList.add('story');
          if (!calm && !saveData && !sessionStorage.getItem('cc-welcomed')) {
            root.classList.add('preload');
            sessionStorage.setItem('cc-welcomed', '1');
          }
        } catch (e) {}
        // If the motion script hasn't started by now, show everything as it is
        setTimeout(function () {
          if (!window.__ccMotion) {
            root.classList.add('motion-off');
            root.classList.remove('preload', 'story');
          }
        }, 5000);
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <InkDefs />
    <Preloader />
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/site-motion';
      import '../scripts/story';
    </script>
  </body>
</html>

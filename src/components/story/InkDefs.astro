---
// The shared shading for every story drawing: hatching, cross-hatching and
// stipple, in the logo brown. Defined once per page so every drawing is shaded
// with exactly the same texture, as if by one illustrator.
---

<svg class="ink-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="ink-hatch" patternUnits="userSpaceOnUse" width="3.2" height="3.2" patternTransform="rotate(40)">
      <line x1="0" y1="0" x2="0" y2="3.2" stroke="#70441d" stroke-width="0.55"></line>
    </pattern>
    <pattern id="ink-cross" patternUnits="userSpaceOnUse" width="3.2" height="3.2" patternTransform="rotate(40)">
      <line x1="0" y1="0" x2="0" y2="3.2" stroke="#70441d" stroke-width="0.55"></line>
      <line x1="0" y1="0" x2="3.2" y2="0" stroke="#70441d" stroke-width="0.45"></line>
    </pattern>
    <pattern id="ink-stipple" patternUnits="userSpaceOnUse" width="5" height="5">
      <circle cx="1" cy="1" r="0.45" fill="#70441d"></circle>
      <circle cx="3.6" cy="2.3" r="0.4" fill="#70441d"></circle>
      <circle cx="2" cy="4.1" r="0.35" fill="#70441d"></circle>
    </pattern>
  </defs>
</svg>

<style>
  .ink-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>

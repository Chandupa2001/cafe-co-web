---
// A classic wooden box coffee mill, in the same fine line as the beans and cup.
// Three-quarter view: front, top and a shaded right side; a drawer with two
// small glass windows either side of its knob; a brass plaque; a brass hopper
// bowl on top; a crank with a turned wooden knob.
//
// Without the story it's simply drawn with two beans resting in the hopper.
// The story script (src/scripts/story.ts) drives these hooks:
//   [data-grinder-reveal]  clip rect that draws the mill in from the bottom up
//   [data-grinder-shade]   tones and hatching, faded in after the lines
//   [data-hopper-bean]     the two whole beans (data-cx/cy/rot/w: resting place)
//   [data-slot="shards"]   where the script puts the beans' broken pieces
//   [data-slot="grains"]   where it puts ground coffee falling behind the windows
//   [data-crank] [data-arm-*] [data-knob] [data-spindle]  the turning crank
//   [data-heap]            the grounds piling up in the drawer
// The pieces and grounds are made by the script (they're only ever seen in the
// story), which keeps the page itself light.
//   [data-drawer] [data-drawer-side] [data-drawer-top]  the drawer sliding out
import Bean from './Bean.astro';
import Machine from './Machine.astro';
import Portafilter from './Portafilter.astro';
import Cup from './Cup.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const uid = `grinder-${Math.random().toString(36).slice(2, 8)}`;

// Faces of the box
const front = 'M60 200H220V370H60Z';
const top = 'M60 200L84 182H244L220 200Z';
const side = 'M220 200L244 182V352L220 370Z';

// Hopper bowl: outside, and the band of rim in front of the opening
const bowl = 'M78 118C80 146 112 170 128 176A24 5 0 0 0 176 176C192 170 224 146 226 118A74 15 0 0 0 78 118Z';
const lip = 'M78 118A74 15 0 0 0 226 118L222 118A70 13 0 0 1 82 118Z';

// Where the beans rest in the bowl (viewBox units)
const beans = [
  { variant: 1 as const, cx: 130, cy: 122, rot: -30, w: 22 },
  { variant: 2 as const, cx: 175, cy: 124, rot: 38, w: 22 },
];

// The drawer's two windows (the story script scatters falling grounds behind them)
const windows = [
  { x: 90, y: 310, w: 34, h: 36 },
  { x: 156, y: 310, w: 34, h: 36 },
];
---

<svg class:list={['ink grinder', className]} viewBox="0 0 300 400" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id={`${uid}-reveal`}>
      <rect data-grinder-reveal x="-20" y="-20" width="340" height="440"></rect>
    </clipPath>
    <clipPath id={`${uid}-front`}>
      <path d={front}></path>
    </clipPath>
    <clipPath id={`${uid}-bowl`}>
      <path d={bowl}></path>
    </clipPath>
    <!-- Beans show above the rim and inside the opening, never through the bowl -->
    <clipPath id={`${uid}-hopper`}>
      <rect x="0" y="-200" width="300" height="318"></rect>
      <ellipse cx="152" cy="118" rx="70" ry="13"></ellipse>
    </clipPath>
    <clipPath id={`${uid}-windows`}>
      {windows.map((w) => <rect x={w.x} y={w.y} width={w.w} height={w.h}></rect>)}
    </clipPath>
  </defs>

  <!-- The whole scene; the story's camera pans it to the machine -->
  <g data-world>
  <g data-grinder-body clip-path={`url(#${uid}-reveal)`}>
    <!-- Plinth -->
    <path class="fw" d="M50 374H230V386H50Z"></path>
    <path class="fc t" d="M230 374L256 355V367L230 386Z"></path>
    <g data-grinder-shade>
      <path class="h" fill="url(#ink-cross)" d="M230 374L256 355V367L230 386Z"></path>
    </g>
    <path class="o" d="M50 374H230V386H50Z"></path>
    <path class="o" d="M230 374L256 355V367L230 386"></path>
    <path class="d" d="M50 374L76 355H256"></path>

    <!-- Box: tones and grain -->
    <g data-grinder-shade>
      <path class="fc t" d={front}></path>
      <path class="fs t" d={top}></path>
      <path class="fc t" d={side}></path>
      <path class="h" fill="url(#ink-hatch)" d={side}></path>
      <path class="h" fill="url(#ink-cross)" d="M220 290L244 272V352L220 370Z"></path>
      <path class="h" fill="url(#ink-hatch)" d="M60 360H220V370H60Z" style="opacity: calc(var(--hatch, 0.55) * 0.6)"></path>
      <g clip-path={`url(#${uid}-front)`}>
        <path class="d" d="M60 214C100 211 150 217 220 212"></path>
        <path class="d" d="M60 226C96 223 118 229 150 224C176 220 200 226 220 223"></path>
        <path class="d" d="M60 286C104 283 156 289 220 284"></path>
        <path class="d" d="M60 364C110 361 160 366 220 362"></path>
      </g>
      <path class="d" d="M68 195C110 193 170 197 226 194"></path>
      <path class="d" d="M80 187C122 185 182 189 236 186"></path>
      <path class="d" d="M228 220C233 250 230 300 234 340"></path>
    </g>

    <!-- Box: edges -->
    <path class="o" d={front}></path>
    <path class="o" d={top}></path>
    <path class="o" d={side}></path>
    <path class="d" d="M66 206H214V364H66Z"></path>

    <!-- Brass plaque -->
    <ellipse class="fw" cx="140" cy="250" rx="36" ry="16"></ellipse>
    <ellipse class="o" cx="140" cy="250" rx="36" ry="16"></ellipse>
    <ellipse class="d" cx="140" cy="250" rx="32" ry="13"></ellipse>
    <text class="plaque" x="140" y="254.5" text-anchor="middle">Cafe’ Co.</text>

    <!-- The opening the drawer leaves behind when it slides out -->
    <path class="fk" d="M78 300H202V356H78Z" style="opacity: 0.35"></path>
    <path fill="url(#ink-cross)" d="M78 300H202V356H78Z"></path>
    <path class="d" d="M78 300L90 309H190L202 300M90 309V356"></path>

    <!-- Drawer -->
    <g data-drawer>
      <!-- Its side and open top, seen only once it slides out (drawn by the story) -->
      <polygon class="fw" data-drawer-side points="202,300 202,300 202,356 202,356"></polygon>
      <polygon class="fc t" data-drawer-side points="202,300 202,300 202,356 202,356"></polygon>
      <polygon class="h" fill="url(#ink-cross)" data-drawer-side points="202,300 202,300 202,356 202,356"></polygon>
      <polygon class="o" data-drawer-side points="202,300 202,300 202,356 202,356"></polygon>
      <polygon class="fw" data-drawer-top points="78,300 202,300 202,300 78,300"></polygon>
      <polygon class="fc" data-drawer-top points="78,300 202,300 202,300 78,300"></polygon>
      <polygon fill="url(#ink-stipple)" data-drawer-top points="78,300 202,300 202,300 78,300"></polygon>
      <polygon class="o" data-drawer-top points="78,300 202,300 202,300 78,300"></polygon>

      <path class="fw" d="M78 300H202V356H78Z"></path>
      <g data-grinder-shade>
        <path class="fc t" d="M78 300H202V356H78Z" style="opacity: calc(var(--tone, 0.5) * 0.7)"></path>
        <path class="h" fill="url(#ink-hatch)" d="M78 350H202V356H78Z"></path>
        <path class="d" d="M86 316C120 313 160 319 194 314"></path>
        <path class="d" d="M86 342C126 339 160 345 194 340"></path>
      </g>
      <path class="o" d="M78 300H202V356H78Z"></path>
      <path class="d" d="M84 306H196V350H84Z"></path>

      <!-- Windows into the drawer: the inside, falling grounds, the heap -->
      {windows.map((w) => <rect class="fs" x={w.x} y={w.y} width={w.w} height={w.h}></rect>)}
      <g data-grinder-shade>
        {windows.map((w) => <rect class="h" x={w.x} y={w.y} width={w.w} height={w.h} fill="url(#ink-hatch)" style="opacity: calc(var(--hatch, 0.55) * 0.45)"></rect>)}
      </g>
      <g clip-path={`url(#${uid}-windows)`}>
        <g data-slot="grains"></g>
        <g data-heap transform="translate(0 36)">
          <path class="fc" d="M80 360V334C96 330 112 326 126 325C134 324 146 324 154 325C168 326 184 330 200 334V360Z"></path>
          <path fill="url(#ink-stipple)" d="M80 360V334C96 330 112 326 126 325C134 324 146 324 154 325C168 326 184 330 200 334V360Z"></path>
          <path class="h" fill="url(#ink-hatch)" d="M80 360V342C100 338 120 335 140 335C160 335 180 338 200 342V360Z"></path>
          <path class="d" d="M80 334C96 330 112 326 126 325C134 324 146 324 154 325C168 326 184 330 200 334"></path>
        </g>
      </g>
      {windows.map((w) => (
        <>
          <rect class="o" x={w.x} y={w.y} width={w.w} height={w.h}></rect>
          <path class="d" d={`M${w.x + 5} ${w.y + 13}L${w.x + 12} ${w.y + 5}`}></path>
        </>
      ))}

      <circle class="fw" cx="140" cy="328" r="7.5"></circle>
      <g data-grinder-shade>
        <circle class="fc t" cx="140" cy="328" r="7.5"></circle>
        <path class="h" fill="url(#ink-cross)" d="M144 322A7.5 7.5 0 0 1 140 335.5A7.5 7.5 0 0 0 144 322Z"></path>
      </g>
      <circle class="o" cx="140" cy="328" r="7.5"></circle>
      <circle class="d" cx="140" cy="328" r="3.5"></circle>
    </g>

    <!-- Collar and neck -->
    <ellipse class="fs" cx="152" cy="191" rx="30" ry="7"></ellipse>
    <ellipse class="o" cx="152" cy="191" rx="30" ry="7"></ellipse>
    <path class="o" d="M130 176L133 189"></path>
    <path class="o" d="M174 176L171 189"></path>

    <!-- Hopper bowl, outside -->
    <path class="fw" d={bowl}></path>
    <g data-grinder-shade>
      <path class="fs t" d={bowl}></path>
      <g clip-path={`url(#${uid}-bowl)`}>
        <path class="h" fill="url(#ink-hatch)" d="M186 110C200 140 196 166 176 182H240V110Z"></path>
        <path class="h" fill="url(#ink-cross)" d="M206 110C214 136 206 160 190 176H240V110Z"></path>
      </g>
    </g>
    <path class="d" d="M86 140A66 12 0 0 0 218 140"></path>
    <path class="d" d="M100 158A52 9 0 0 0 204 158"></path>
    <path class="o" d="M78 118C80 146 112 170 128 176A24 5 0 0 0 176 176C192 170 224 146 226 118"></path>

    <!-- Hopper opening -->
    <ellipse class="fs" cx="152" cy="118" rx="70" ry="13"></ellipse>
    <g data-grinder-shade>
      <ellipse class="h" cx="152" cy="118" rx="70" ry="13" fill="url(#ink-hatch)"></ellipse>
      <ellipse class="h" cx="152" cy="121" rx="28" ry="5.5" fill="url(#ink-cross)"></ellipse>
    </g>
    <ellipse class="d" cx="152" cy="121" rx="28" ry="5.5"></ellipse>

    <!-- The beans in the bowl, and the pieces they break into -->
    <g clip-path={`url(#${uid}-hopper)`}>
      {beans.map((b) => (
        <g data-hopper-bean data-cx={b.cx} data-cy={b.cy} data-rot={b.rot} data-w={b.w}>
          <g transform={`translate(${b.cx} ${b.cy}) rotate(${b.rot})`}>
            <Bean variant={b.variant} x={-b.w / 2} y={(-b.w * 4) / 3 / 2} width={b.w} height={(b.w * 4) / 3} />
          </g>
        </g>
      ))}
      <g data-slot="shards"></g>
    </g>

    <!-- Spindle -->
    <g data-spindle>
      <path class="o" d="M150.5 121V64"></path>
      <path class="o" d="M153.5 121V64"></path>
    </g>

    <!-- Rim, in front of the opening -->
    <path class="fs" d={lip}></path>
    <path class="o" d="M78 118A74 15 0 0 0 226 118"></path>
    <ellipse class="o" cx="152" cy="118" rx="70" ry="13"></ellipse>

    <!-- Crank: arm and turned wooden knob -->
    <g data-crank>
      <path class="fw" data-arm-fill d="M152 61.5C175 59.5 195 65.5 214 62.5V67C195 70 175 64 152 66.5Z"></path>
      <path class="o" data-arm-top d="M152 61.5C175 59.5 195 65.5 214 62.5"></path>
      <path class="o" data-arm-bottom d="M152 66.5C175 64 195 70 214 67"></path>
      <g data-knob>
        <path class="fw" d="M209.5 65C208 58 211 55 210 50C209 44 210 38 214 37C218 38 219 44 218 50C217 55 220 58 218.5 65Z"></path>
        <g data-grinder-shade>
          <path class="fc t" d="M209.5 65C208 58 211 55 210 50C209 44 210 38 214 37C218 38 219 44 218 50C217 55 220 58 218.5 65Z"></path>
          <path class="h" fill="url(#ink-cross)" d="M215 37.5C218 38 219 44 218 50C217 55 220 58 218.5 65H215Z"></path>
        </g>
        <path class="o" d="M209.5 65C208 58 211 55 210 50C209 44 210 38 214 37C218 38 219 44 218 50C217 55 220 58 218.5 65Z"></path>
        <ellipse class="fw" cx="214" cy="65.5" rx="5.5" ry="1.8"></ellipse>
        <ellipse class="o" cx="214" cy="65.5" rx="5.5" ry="1.8"></ellipse>
      </g>
    </g>
    <ellipse class="fw" cx="152" cy="64" rx="7" ry="3"></ellipse>
    <ellipse class="o" cx="152" cy="64" rx="7" ry="3"></ellipse>
  </g>

  <!-- Grounds pouring from the drawer (made by the story script) -->
  <g data-slot="pour"></g>

  <!-- To the left, out of view until the camera pans: the machine, with the
       portafilter between its body and its group head -->
  <Machine part="back" uid={uid} />

  <!-- The espresso streams and the cup on the drip tray (machine coordinates).
       The cup waits off to the right until the story slides it under the spout. -->
  <g transform="translate(-450 0)">
    <line class="o k" data-stream x1="137.4" y1="279.5" x2="137.4" y2="279.5" opacity="0"></line>
    <line class="o k" data-stream x1="142.6" y1="279.5" x2="142.6" y2="279.5" opacity="0"></line>
    <g data-cup transform="translate(190 0)">
      <Cup steam x={94.4} y={254.04} width={91.2} height={95} />
    </g>
  </g>

  <Portafilter />
  <Machine part="front" uid={uid} />
  </g>
</svg>

<style>
  /* A window onto the scene: what's beyond its edges (the machine, until the
     camera pans to it) stays out of sight */
  .grinder {
    overflow: hidden;
  }

  .plaque {
    fill: var(--accent);
    font-family: var(--font-display);
    font-size: 12.5px;
    letter-spacing: 0.02em;
  }
</style>

---
// Three slow wisps of steam. Drawn inside a cup's SVG, above its rim
// (the cup's drawing space leaves room for them at the top).
// Each path has pathLength="1" so the animation can trace it by fraction.
---

<g class="steam" data-cup-steam>
  <path class="o" pathLength="1" d="M101 98C93 85 109 75 101 61C95 51 105 42 100.5 30"></path>
  <path class="o" pathLength="1" d="M120 92C112 77 130 66 120.5 50C113 38 124.5 28 119 15"></path>
  <path class="o" pathLength="1" d="M139.5 98C131.5 85 147.5 75 139.5 61C133.5 51 143.5 42 139 30"></path>
</g>

---
import Photo from './Photo.astro';
import { menu, sample } from '../data/menu';
import { site } from '../data/site';

const lkr = new Intl.NumberFormat('en-LK');
const categories = [...new Set(menu.map((item) => item.category))];
---

<section id="menu" class="section wrap menu">
  <div class="photo-col reveal">
    <Photo name="menu" tint="stone" sizes="(min-width: 960px) 30rem, 100vw" widths={[480, 800, 1200]} />
  </div>

  <div class="list-col">
    <div class="reveal">
      <h2 class="display">From our counter</h2>
      {sample && <p class="sample">Sample menu. These items and prices are placeholders.</p>}
    </div>

    {categories.map((category) => (
      <div class="group reveal">
        <h3 class="eyebrow">{category}</h3>
        <ul role="list">
          {menu
            .filter((item) => item.category === category)
            .map((item) => (
              <li>
                <div>
                  <p class="name">{item.name}</p>
                  <p>{item.description}</p>
                </div>
                <p class="price">LKR {lkr.format(item.price)}</p>
              </li>
            ))}
        </ul>
      </div>
    ))}

    <div class="reveal">
      <a class="btn" href={site.links.whatsapp} target="_blank" rel="noopener">Order or reserve on WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .menu {
    display: grid;
    gap: 3rem;
  }

  .photo-col {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .list-col {
    display: grid;
    gap: 3rem;
    align-content: start;
  }

  .sample {
    margin-top: 1rem;
    color: var(--accent);
    font-size: 0.9375rem;
  }

  ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--line);
  }

  .name {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.2;
  }

  .price {
    flex: none;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 960px) {
    .menu {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }

    /* The photo stays in view while the list scrolls past */
    .photo-col {
      position: sticky;
      top: 2rem;
      aspect-ratio: 4 / 5;
    }
  }
</style>
